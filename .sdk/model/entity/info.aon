# Entity: info

main: kit: entity: info: {

  alias: field: {}

  fields: [
    {
      name: "dataSources"
      req: false
      type: "`$ARRAY`"
    }
    {
      format: "date-time"
      name: "lastUpdated"
      req: false
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "info"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/info"
          segments: [
            {
              lit: "info"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.dataSources`"
          }
        }
      ]
    }
  }



}
